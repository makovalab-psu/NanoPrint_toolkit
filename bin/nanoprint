#!/bin/bash
set -euo pipefail

# Resolve toolkit root from this script's location (bin/ is one level below root)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TOOLKIT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SCRIPTS="$TOOLKIT_ROOT/workflow/scripts"

# ---------------------------------------------------------------------------
# Default Dorado model
#
# An exact model with CpG 5mC/5hmC calling built in, written as the full combined
# name that `dorado download --list` prints under "modification models".
#
# Why modifications at all: without them dorado emits no MM/ML tags, no methylation
# analysis is possible downstream, and since basecalling is the expensive step,
# finding out later means running it again. `5mCG_5hmCG` is CpG-context (not the
# all-context `5mC_5hmC`) and matches the makova_fire FIBER-Seq pipeline
# (sup,5mCG_5hmCG,6mA) — comparing datasets basecalled with different modification
# models measures the models, not the samples.
#
# Why the exact name rather than the 'sup' shorthand: 'sup' resolves against each
# pod5's own chemistry metadata, so two runs basecalled months apart can silently
# use different models. The cost is that a pod5 from another chemistry or sampling
# rate is now mis-called or rejected instead of auto-matched.
#
# MODEL STRING SYNTAX — tested on the P2i, dorado 1.3.3, 2026-08-05.
# Do not "fix" this string from the dorado docs without running it; two plausible
# forms inferred from `dorado download --list` both failed:
#
#   sup,5mCG_5hmCG                                    WORKS (resolves to the name below)
#   dna_r10.4.1_e8.2_400bps_sup@v5.2.0,5mCG_5hmCG     FAILS: "'5mCG_5hmCG' is not a
#                                                     recognised model name"
#   dna_r10.4.1_e8.2_400bps_sup@v5.2.0,5mCG_5hmCG@v2  FAILS: same, for '5mCG_5hmCG@v2'
#   dna_r10.4.1_e8.2_400bps_sup@v5.2.0_5mCG_5hmCG@v2  the default below (underscore,
#                                                     the full combined model name)
#
# A bare modification after a comma resolves only against the shorthand. If the
# default is ever rejected at parse time (the error appears in under a second, before
# any GPU work), fall back to -m sup,5mCG_5hmCG, which is confirmed working.
#
# Use -m sup for the old modification-free behaviour.
#
# KEEP IN SYNC with DORADO_MODEL in workflow/scripts/CONFIG.sh, which is the
# same default for the Snakemake (pod5-input) path.
# ---------------------------------------------------------------------------
DEFAULT_DORADO_MODEL="dna_r10.4.1_e8.2_400bps_sup@v5.2.0_5mCG_5hmCG@v2"

# ---------------------------------------------------------------------------
# usage helpers
# ---------------------------------------------------------------------------

usage_main() {
    cat << EOF
Usage: $(basename "$0") <subcommand> [options]

Subcommands:
    preprocess    Basecall pod5 files, align to a reference genome, and run
                  Uncalled4 pore-model signal alignment. Produces a BAM ready
                  to transfer to a CPU-only cluster (e.g. ROAR) for the
                  remaining NanoPrint pipeline steps.

Run '$(basename "$0") <subcommand> -h' for subcommand-specific help.

PATH setup (add once to ~/.bashrc or ~/.zshrc):
    export PATH="$TOOLKIT_ROOT/bin:\$PATH"
EOF
    exit 1
}

usage_preprocess() {
    cat << EOF
Usage: $(basename "$0") preprocess -i <pod5_path> -g <genome.fa> -o <output.bam> -p <threads> [-m <model>] [-T <tmp_dir>] [--keep-basecalled] [--keep-aligned] [--keep-filtered]

Run all GPU-intensive preprocessing steps to produce an Uncalled4 BAM:

    Step 1  dorado basecaller   pod5 → basecalled BAM (with --emit-moves)
    Step 2  minimap2 + samtools basecalled BAM → aligned BAM (mv/ts/fn tags preserved)
    Step 3  samtools view       aligned BAM → filtered BAM (MAPQ >= 20, no secondary/supplementary)
    Step 4  uncalled4 align     filtered BAM split by pod5 source → per-pod5 Uncalled4 BAMs,
                               merged and sorted → final Uncalled4 BAM (DTW signal alignment)

The output BAM (and its .bai index) can be transferred to ROAR and used as
input to the NanoPrint Snakemake pipeline in place of Phase 0 steps.

Required arguments:
    -i    Pod5 file or directory (directories are searched recursively)
    -g    Reference genome FASTA
    -o    Output Uncalled4 BAM
    -p    Threads / parallel processes to use

Optional arguments:
    -m    Dorado basecalling model
          Default: dna_r10.4.1_e8.2_400bps_sup@v5.2.0_5mCG_5hmCG@v2
            An exact model with CpG 5mC/5hmC calling built in, so output BAMs
            carry MM/ML modification tags and runs stay comparable to each other.
            Because it names a specific model rather than the 'sup' shorthand,
            pod5s from a different chemistry are NOT auto-matched and will be
            mis-called or rejected — override if your data is not
            R10.4.1 / E8.2 / 400 bps.
          Alternatives:
            sup,5mCG_5hmCG   auto-select chemistry, keep modification calling
            sup              auto-select chemistry, no modification calling
            hac, fast        faster/less accurate, no modification calling
          Note the underscore in the default. A modification after a COMMA only
          resolves against the shorthand: 'sup,5mCG_5hmCG' works, but
          'dna_..._sup@v5.2.0,5mCG_5hmCG' and '...,5mCG_5hmCG@v2' are both
          rejected with "is not a recognised model name" (dorado 1.3.3).
          Valid full names are what 'dorado download --list' prints.
          If the default is ever rejected, use -m sup,5mCG_5hmCG.
    -T    Directory for intermediate files (default: <output_dir>/tmp_nanoprint_<PID>)
          Deleted on exit regardless of success or failure. Intermediates NOT
          persisted via --keep-* live here and are lost if a later step fails.
    --keep-basecalled   Persist the step 1 (Dorado) output next to -o.
    --keep-aligned      Persist the step 2 (minimap2) output next to -o.
    --keep-filtered     Persist the step 3 (filter) output next to -o.
    --keep-all          Shorthand for all three --keep-* flags above.
    -h, --help    Show this help

Persisted files are written as:
    <output_dir>/<output_stem>_basecalled.bam
    <output_dir>/<output_stem>_aligned.bam
    <output_dir>/<output_stem>_filtered.bam (+ .bai)

Auto-resume: if one of these files already exists when preprocess starts, that
step AND every step before it are skipped, and the existing file is reused —
even if you don't pass the matching --keep-* flag on this invocation. This is
what protects a multi-day Dorado run from being lost to a bug discovered in a
later step: fix the bug, rerun with the same -o, and only the failed step(s)
redo. Delete the persisted file yourself to force a step to rerun from scratch.

Dependencies (must be in PATH):
    dorado      https://github.com/nanoporetech/dorado/releases
    samtools    conda install -c bioconda samtools
    minimap2    conda install -c bioconda minimap2
    uncalled4   pip install uncalled4  (also: pip install "pyarrow>=14,<20")

Example:
    nanoprint preprocess \\
        -i /data/runs/run01/pod5_pass/ \\
        -g /references/hg38.fa \\
        -o results/HG002_Mn04_uncalled4.bam \\
        -p 16

Output files:
    results/HG002_Mn04_uncalled4.bam      Uncalled4 BAM (coordinate-sorted)
    results/HG002_Mn04_uncalled4.bam.bai  BAM index
EOF
    exit 1
}

# ---------------------------------------------------------------------------
# preprocess subcommand
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# has_mod_tags <bam> — true if the BAM carries base modification calls.
#
# Scans the first MOD_TAG_SCAN_READS records rather than the whole file; dorado
# writes MM/ML on every read of a modification basecall, so a sample this size is
# decisive. Both spellings are checked: MM/ML is current, Mm/Ml is the older
# hts-specs form that pre-2022 basecalls still carry.
#
# Used to verify that modification calls survive each step that rewrites the BAM.
# They are dropped silently when they don't, which is a failure mode this pipeline
# has already shipped twice (see the tag-allowlist note in Map_reads.sh).
# ---------------------------------------------------------------------------
MOD_TAG_SCAN_READS=5000

has_mod_tags() {
    local bam="$1" n
    [[ -f "$bam" ]] || return 1
    # pipefail off for this pipeline only: `samtools view | head` SIGPIPEs samtools
    # by design once head has its lines, which would otherwise abort the script.
    set +o pipefail
    n=$(samtools view "$bam" 2>/dev/null \
        | head -n "$MOD_TAG_SCAN_READS" \
        | grep -cE "$(printf '\t')(MM|Mm):Z:" || true)
    set -o pipefail
    [[ "${n:-0}" -gt 0 ]]
}

cmd_preprocess() {
    local INPUT="" GENOME="" OUTPUT="" THREADS="" MODEL="$DEFAULT_DORADO_MODEL" TMP_DIR=""
    local KEEP_BASECALLED=false KEEP_ALIGNED=false KEEP_FILTERED=false

    # Manual loop (not getopts) — needed for --keep-* long options.
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -i) INPUT="$2"; shift 2 ;;
            -g) GENOME="$2"; shift 2 ;;
            -o) OUTPUT="$2"; shift 2 ;;
            -p) THREADS="$2"; shift 2 ;;
            -m) MODEL="$2"; shift 2 ;;
            -T) TMP_DIR="$2"; shift 2 ;;
            --keep-basecalled) KEEP_BASECALLED=true; shift ;;
            --keep-aligned)    KEEP_ALIGNED=true; shift ;;
            --keep-filtered)   KEEP_FILTERED=true; shift ;;
            --keep-all)
                KEEP_BASECALLED=true; KEEP_ALIGNED=true; KEEP_FILTERED=true
                shift ;;
            -h|--help) usage_preprocess ;;
            *)
                echo "Error: Unknown option: $1" >&2
                usage_preprocess ;;
        esac
    done

    # --- validate required arguments ---
    local missing=0
    [[ -z "$INPUT"   ]] && { echo "Error: -i (pod5 input) is required"   >&2; missing=1; }
    [[ -z "$GENOME"  ]] && { echo "Error: -g (genome FASTA) is required" >&2; missing=1; }
    [[ -z "$OUTPUT"  ]] && { echo "Error: -o (output BAM) is required"   >&2; missing=1; }
    [[ -z "$THREADS" ]] && { echo "Error: -p (threads) is required"      >&2; missing=1; }
    [[ $missing -eq 1 ]] && usage_preprocess

    [[ ! -e "$INPUT"  ]] && { echo "Error: Input not found: $INPUT"          >&2; exit 1; }
    [[ ! -f "$GENOME" ]] && { echo "Error: Genome FASTA not found: $GENOME"  >&2; exit 1; }

    # --- check dependencies ---
    for tool in dorado samtools minimap2 uncalled4; do
        command -v "$tool" &>/dev/null || {
            echo "Error: '$tool' not found in PATH" >&2
            exit 1
        }
    done

    # --- set up output and temp directories ---
    mkdir -p "$(dirname "$OUTPUT")"
    local OUT_DIR
    OUT_DIR="$(cd "$(dirname "$OUTPUT")" && pwd)"

    if [[ -z "$TMP_DIR" ]]; then
        TMP_DIR="${OUT_DIR}/tmp_nanoprint_$$"
    fi
    mkdir -p "$TMP_DIR"

    # Bake the literal path into the trap string now so it survives outside
    # cmd_preprocess's local variable scope when the EXIT trap fires.
    trap "rm -rf '${TMP_DIR}'" EXIT

    # --keep-* flags persist intermediates next to -o instead of TMP_DIR (which
    # is rm -rf'd on exit). If a persisted file from a prior run already
    # exists, its step and every step before it are skipped automatically —
    # regardless of whether --keep-* is passed this run. This is what protects
    # a multi-day step like basecalling from being lost when a later step
    # (e.g. Uncalled4) turns out to have a bug: fix it, rerun with the same
    # -o, and only the failed step(s) redo.
    local STEM
    STEM="$(basename "$OUTPUT" .bam)"
    local PERSIST_BASECALLED="${OUT_DIR}/${STEM}_basecalled.bam"
    local PERSIST_ALIGNED="${OUT_DIR}/${STEM}_aligned.bam"
    local PERSIST_FILTERED="${OUT_DIR}/${STEM}_filtered.bam"

    echo "========================================"
    echo " NanoPrint preprocess"
    echo "========================================"
    printf "%-10s %s\n" "Input:"   "$INPUT"
    printf "%-10s %s\n" "Genome:"  "$GENOME"
    printf "%-10s %s\n" "Output:"  "$OUTPUT"
    printf "%-10s %s\n" "Threads:" "$THREADS"
    printf "%-10s %s\n" "Model:"   "$MODEL"
    printf "%-10s %s\n" "Tmp dir:" "$TMP_DIR"
    echo "========================================"
    echo ""

    local BASECALLED="" ALIGNED="" FILTERED=""

    if [[ -f "$PERSIST_FILTERED" ]]; then
        echo "Found existing filtered BAM, resuming from step 4: $PERSIST_FILTERED"
        FILTERED="$PERSIST_FILTERED"
        [[ -f "${FILTERED}.bai" ]] || samtools index "$FILTERED"
        echo ""
    elif [[ -f "$PERSIST_ALIGNED" ]]; then
        echo "Found existing aligned BAM, resuming from step 3: $PERSIST_ALIGNED"
        ALIGNED="$PERSIST_ALIGNED"
        echo ""
    elif [[ -f "$PERSIST_BASECALLED" ]]; then
        echo "Found existing basecalled BAM, resuming from step 2: $PERSIST_BASECALLED"
        BASECALLED="$PERSIST_BASECALLED"
        echo ""
    fi

    # -----------------------------------------------------------------------
    # Step 1: Dorado basecalling
    # -----------------------------------------------------------------------
    if [[ -n "$BASECALLED" || -n "$ALIGNED" || -n "$FILTERED" ]]; then
        echo "[1/4] Dorado basecalling — skipped (reusing existing output)"
    else
        echo "[1/4] Dorado basecalling (model: $MODEL)..."
        if [[ "$KEEP_BASECALLED" == true ]]; then
            BASECALLED="$PERSIST_BASECALLED"
        else
            BASECALLED="${TMP_DIR}/basecalled.bam"
        fi
        "$SCRIPTS/Dorado_basecall.sh" \
            -i "$INPUT" \
            -o "$BASECALLED" \
            -m "$MODEL" \
            -t "$THREADS"
    fi
    echo ""

    # -----------------------------------------------------------------------
    # Step 2: Align to genome (preserving dorado tags)
    # samtools fastq -T "MM,ML,mv,ts,pi,sp,ns,fn" | minimap2 -y keeps the tags
    # uncalled4 needs for DTW signal alignment, the fn tag (source pod5 basename)
    # that step 4 needs to split reads by pod5, and the MM/ML base modification
    # calls. That -T list is an allowlist — see Map_reads.sh before adding a
    # consumer that depends on any other dorado tag.
    # -----------------------------------------------------------------------
    if [[ -n "$ALIGNED" || -n "$FILTERED" ]]; then
        echo "[2/4] Aligning to genome — skipped (reusing existing output)"
    else
        echo "[2/4] Aligning to genome with minimap2 (preserving move tags)..."
        if [[ "$KEEP_ALIGNED" == true ]]; then
            ALIGNED="$PERSIST_ALIGNED"
        else
            ALIGNED="${TMP_DIR}/aligned.bam"
        fi
        "$SCRIPTS/Map_reads.sh" \
            -i "$BASECALLED" \
            -o "$ALIGNED" \
            -g "$GENOME" \
            -T "${TMP_DIR}/map_reads_tmp" \
            -t "$THREADS"

        # Modification calls must survive alignment. Map_reads.sh preserves tags
        # through an explicit `samtools fastq -T` allowlist, and anything missing
        # from that list is dropped without a word — which is how a whole WGS BAM
        # once reached modkit with no methylation calls in it and every record
        # failed. Checked here, while the basecalled BAM is still around to
        # compare against, rather than discovered days downstream.
        if has_mod_tags "$BASECALLED" && ! has_mod_tags "$ALIGNED"; then
            echo "" >&2
            echo "Error: base modification tags (MM/ML) are present in the basecalled BAM" >&2
            echo "       but absent from the aligned BAM — alignment dropped them." >&2
            echo "         basecalled: $BASECALLED" >&2
            echo "         aligned:    $ALIGNED" >&2
            echo "" >&2
            echo "       Fix: add MM,ML to the tag allowlist in" >&2
            echo "       workflow/scripts/Map_reads.sh (samtools fastq -T \"...\")." >&2
            echo "" >&2
            echo "       Then delete ${PERSIST_ALIGNED} if it exists and re-run with the" >&2
            echo "       same -o. With --keep-basecalled the basecalling step is reused," >&2
            echo "       so this costs no GPU time." >&2
            exit 1
        fi

        [[ "$BASECALLED" == "$PERSIST_BASECALLED" ]] || rm -f "$BASECALLED"
    fi
    echo ""

    # -----------------------------------------------------------------------
    # Step 3: Filter alignments
    # MAPQ >= 20, remove secondary (0x100) and supplementary (0x800).
    # samtools view preserves all BAM tags, so MM/ML/mv/ts/pi/sp/ns/fn survive.
    # -----------------------------------------------------------------------
    if [[ -n "$FILTERED" ]]; then
        echo "[3/4] Filtering alignments — skipped (reusing existing output)"
    else
        echo "[3/4] Filtering alignments (MAPQ >= 20, no secondary/supplementary)..."
        if [[ "$KEEP_FILTERED" == true ]]; then
            FILTERED="$PERSIST_FILTERED"
        else
            FILTERED="${TMP_DIR}/filtered.bam"
        fi
        "$SCRIPTS/Filter_alignments.sh" \
            -i "$ALIGNED" \
            -o "$FILTERED"
        samtools index "$FILTERED"
        [[ "$ALIGNED" == "$PERSIST_ALIGNED" ]] || rm -f "$ALIGNED"
    fi
    echo ""

    # -----------------------------------------------------------------------
    # Step 4: Uncalled4 signal alignment — batched per pod5 for sequential I/O
    #
    # Dorado records each read's source pod5 filename in the fn:Z: BAM tag.
    # A single streaming pass through filtered.bam (awk) routes reads into
    # per-pod5 BAMs by piping to samtools view. On the first read for each
    # pod5, awk sends the BAM header through the pipe so samtools can write a
    # valid BAM; subsequent reads flow into the already-open pipe. Each pod5
    # batch is then aligned independently so uncalled4 reads one pod5
    # sequentially rather than seeking randomly across all pod5 files.
    # Results are merged, sorted, and indexed at the end.
    # -----------------------------------------------------------------------
    echo "[4/4] Uncalled4 pore-model signal alignment (batched per pod5)..."

    # Build pod5 file list
    local POD5_LIST="${TMP_DIR}/pod5_files.txt"
    if [[ -f "$INPUT" && "$INPUT" == *.pod5 ]]; then
        echo "$INPUT" > "$POD5_LIST"
    else
        find "$INPUT" -name "*.pod5" -type f | sort > "$POD5_LIST"
    fi
    local N_POD5
    N_POD5=$(wc -l < "$POD5_LIST")
    [[ "$N_POD5" -eq 0 ]] && { echo "Error: No .pod5 files found under $INPUT" >&2; exit 1; }
    echo "  Found $N_POD5 pod5 file(s)"

    # Dorado writes only the basename into fn:Z:, so duplicate basenames across
    # subdirectories would cause reads from two pod5 files to merge into one
    # split BAM, with the second pod5's signal data silently dropped.
    local DUP_COUNT
    DUP_COUNT=$(awk -F/ '{print $NF}' "$POD5_LIST" | sort | uniq -d | wc -l)
    if [[ "$DUP_COUNT" -gt 0 ]]; then
        echo "Error: duplicate pod5 basenames found in input directory:" >&2
        awk -F/ '{print $NF}' "$POD5_LIST" | sort | uniq -d | head -5 | sed 's/^/    /' >&2
        echo "  nanoprint requires unique pod5 basenames across all subdirectories." >&2
        exit 1
    fi

    # Split filtered BAM into per-pod5 BAMs.
    # Strategy: sort by fn:Z: tag so all reads from the same pod5 are adjacent,
    # then stream through awk keeping only ONE samtools pipe open at a time.
    # (The naive approach of opening one pipe per pod5 simultaneously fails with
    # EMFILE once the pod5 count exceeds ~ulimit -n / 2, typically ~500.)
    local SPLIT_DIR="${TMP_DIR}/split"
    mkdir -p "$SPLIT_DIR"
    local HEADER_SAM="${SPLIT_DIR}/_header.sam"
    samtools view -H "$FILTERED" > "$HEADER_SAM"

    echo "  Sorting filtered BAM by pod5 source tag..."
    local FN_SORTED="${TMP_DIR}/fn_sorted.bam"
    samtools sort -@ "$THREADS" -t fn \
        -T "${TMP_DIR}/fnsort_tmp" \
        -o "$FN_SORTED" "$FILTERED"

    echo "  Splitting by pod5 source (single pass, BAM output)..."
    samtools view -@ "$THREADS" "$FN_SORTED" \
      | awk -v dir="$SPLIT_DIR" -v hdr="$HEADER_SAM" '
    BEGIN {
        while ((getline line < hdr) > 0) header = header line "\n"
        cur_stem = ""; cur_cmd = ""
    }
    {
        fn = ""
        for (i = 12; i <= NF; i++) {
            if (substr($i, 1, 5) == "fn:Z:") { fn = substr($i, 6); break }
        }
        if (fn == "") fn = "_no_fn"
        stem = fn; sub(/\.pod5$/, "", stem)
        if (stem != cur_stem) {
            if (cur_cmd != "") close(cur_cmd)
            cur_cmd = "samtools view -bS -o " dir "/" stem ".bam"
            printf "%s", header | cur_cmd
            cur_stem = stem
        }
        print | cur_cmd
    }
    END { if (cur_cmd != "") close(cur_cmd) }'
    rm -f "$FN_SORTED"

    if [[ -f "${SPLIT_DIR}/_no_fn.bam" ]]; then
        echo "  Warning: some reads lack an fn tag and were excluded" >&2
    fi
    echo "  Split complete."

    # Process each pod5 in turn — sequential I/O, no random cross-file seeking
    local UC4_DIR="${TMP_DIR}/uc4"
    mkdir -p "$UC4_DIR"
    local UC4_BAM_LIST="${TMP_DIR}/uc4_bams.txt"
    > "$UC4_BAM_LIST"

    local pod5_num=0
    while IFS= read -r pod5_file; do
        pod5_num=$((pod5_num + 1))
        local fn_name
        fn_name="$(basename "$pod5_file")"
        local pod5_stem="${fn_name%.pod5}"
        local split_bam="${SPLIT_DIR}/${pod5_stem}.bam"
        local uc4_bam="${UC4_DIR}/${pod5_stem}_uc4.bam"

        if [[ ! -f "$split_bam" ]]; then
            echo "  [$pod5_num/$N_POD5] $fn_name — no reads after filtering, skipped"
            continue
        fi

        echo "  [$pod5_num/$N_POD5] $fn_name"

        samtools index "$split_bam"

        # uncalled4 returns non-zero when any reads fail DTW; use || true and
        # check for output rather than relying on exit code.
        uncalled4 align \
            --bam-in "$split_bam" \
            --ref    "$GENOME" \
            --reads  "$pod5_file" \
            -p       "$THREADS" \
            --min-aln-length 50 \
            -o       "$uc4_bam" || true

        rm -f "$split_bam" "${split_bam}.bai"

        if [[ -f "$uc4_bam" ]]; then
            echo "$uc4_bam" >> "$UC4_BAM_LIST"
        else
            echo "    Warning: uncalled4 produced no output for $fn_name" >&2
        fi
    done < "$POD5_LIST"

    local N_UC4
    N_UC4=$(wc -l < "$UC4_BAM_LIST")
    if [[ "$N_UC4" -eq 0 ]]; then
        echo "Error: Uncalled4 produced no output BAMs" >&2
        exit 1
    fi

    # Concatenate all per-pod5 uncalled4 BAMs (unsorted), sort once, and index
    echo ""
    echo "  Merging $N_UC4 per-pod5 BAMs, sorting, and indexing..."
    samtools cat -b "$UC4_BAM_LIST" \
        | samtools sort -@ "$THREADS" -T "${TMP_DIR}/sort_tmp" -o "$OUTPUT"
    samtools index "$OUTPUT"
    echo ""

    # uncalled4 rewrites every record, and whether it propagates tags it does not
    # itself use is outside our control. If the modification calls did not survive
    # it, the filtered BAM is the last copy that has them — and unless
    # --keep-filtered was passed it lives in TMP_DIR, seconds away from the EXIT
    # trap. Rescue it rather than silently destroying the only modBAM, which is
    # what "retain the modification data" has to mean when the last tool in the
    # chain is a third-party one.
    if has_mod_tags "$FILTERED" && ! has_mod_tags "$OUTPUT"; then
        echo "Warning: base modification tags (MM/ML) did not survive uncalled4 align." >&2
        echo "         The Uncalled4 BAM has the DTW signal data but no methylation calls." >&2
        if [[ "$FILTERED" == "$PERSIST_FILTERED" ]]; then
            echo "         The modification calls are preserved in: $PERSIST_FILTERED" >&2
        else
            echo "         Preserving the pre-uncalled4 BAM, which still has them:" >&2
            cp "$FILTERED" "$PERSIST_FILTERED"
            samtools index "$PERSIST_FILTERED"
            echo "           $PERSIST_FILTERED" >&2
        fi
        echo "         Use that BAM for methylation analysis (modkit etc.), and the" >&2
        echo "         Uncalled4 BAM for signal analysis." >&2
        echo "" >&2
    fi

    echo "========================================"
    echo " Done."
    echo ""
    printf "  %-8s %s\n" "BAM:"   "$OUTPUT"
    printf "  %-8s %s\n" "Index:" "${OUTPUT}.bai"
    echo ""
    echo " Transfer both files to ROAR to continue"
    echo " the NanoPrint pipeline."
    echo "========================================"
}

# ---------------------------------------------------------------------------
# main dispatch
# ---------------------------------------------------------------------------

[[ $# -eq 0 ]] && usage_main

SUBCOMMAND="$1"
shift

case "$SUBCOMMAND" in
    preprocess)  cmd_preprocess "$@" ;;
    -h|--help)   usage_main ;;
    *)
        echo "Error: Unknown subcommand '$SUBCOMMAND'" >&2
        echo "" >&2
        usage_main
        ;;
esac
